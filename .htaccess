RewriteEngine On

# Redirect no-www to www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.quentin-bastos.com/$1 [R=301,L]

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old v1 pages
RewriteRule ^projects_en\.html$ /en#projects [R=301,NE,L]
RewriteRule ^(about|contact_en)\.html$ / [R=301,L]

# No trailing slash
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Drop .html from public URLs
RewriteCond %{THE_REQUEST} \s/([^?\s]+)\.html[\s?]
RewriteCond %1 !^index$
RewriteRule ^ /%1 [R=301,L]

# Serve /page from page.html, even when a /page/ folder exists (/en, /en/...)
DirectorySlash Off
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Hashed build assets only
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
