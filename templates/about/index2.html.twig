{% extends 'base.html.twig' %}
{% block title2 %} · {{ "nav.about"|trans }}{% endblock %}

{% set skills = [
    {
        key: 'backend',
        items: [
            {name: 'PHP', icon: null},
            {name: 'Symfony', icon: 'symfony'},
            {name: 'MySQL', icon: null},
            {name: 'Node.js', icon: 'node'},
            {name: 'Java', icon: 'java'},
            {name: 'C/C++', icon: null},
        ],
    },
    {
        key: 'frontend',
        items: [
            {name: 'Vue', icon: 'vue'},
            {name: 'TypeScript', icon: 'typescript'},
            {name: 'JavaScript', icon: 'js'},
            {name: 'Angular', icon: 'angular'},
            {name: 'Tailwind', icon: 'tailwinds'},
            {name: 'Twig', icon: 'twig'},
            {name: 'SASS', icon: 'scss'},
        ],
    },
    {
        key: 'devops',
        items: [
            {name: 'Docker', icon: 'docker'},
            {name: 'Git', icon: 'git'},
            {name: 'GitHub Actions', icon: 'github'},
            {name: 'Linux', icon: null},
            {name: 'Figma', icon: 'figma'},
        ],
    },
] %}

{% block body %}
    <canvas id="projector"></canvas>
    {% include "header.html.twig" %}
    <main>
        <div class="wrapper">
            <span class="heroKicker smallBaseSize">{{ 'about.kicker'|trans }}</span>
            <h1 class="title middleBaseSize text-start">{{ 'about.hero_title'|trans }}</h1>
        </div>
        <div class="more">
            <a href="#experience" class="textBaseSize arrowMore">
                <span class="textBaseSize">{{ 'about.more'|trans }}</span>
                <img src="{{ asset('assets/svg/arrow.svg') }}" alt="">
            </a>
        </div>
    </main>

    <section id="experience" class="sectionPath">
        <h2>{{ 'about.experience_title'|trans }}</h2>
        <ol class="timeline">
            {% for item in experience %}
                {% set k = 'experience.' ~ item.key %}
                <li>
                    <div class="tl-when">
                        {{ (k ~ '.period')|trans }}
                        <span>{{ (k ~ '.place')|trans }}</span>
                    </div>
                    <div>
                        <h3 class="tl-title">{{ (k ~ '.title')|trans }}</h3>
                        <p class="tl-org">{{ (k ~ '.org')|trans }}</p>
                        <div class="tl-body">
                            <ul class="pd-list">
                                {% for i in 1..item.points %}
                                    <li>{{ (k ~ '.point_' ~ i)|trans }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ol>
    </section>

    <section id="education" class="sectionPath">
        <h2>{{ 'about.education_title'|trans }}</h2>
        <ol class="timeline">
            {% for key in education %}
                {% set k = 'education.' ~ key %}
                <li>
                    <div class="tl-when">
                        {{ (k ~ '.period')|trans }}
                        <span>{{ (k ~ '.place')|trans }}</span>
                    </div>
                    <div>
                        <h3 class="tl-title">{{ (k ~ '.title')|trans }}</h3>
                        <p class="tl-org">{{ (k ~ '.org')|trans }}</p>
                        <div class="tl-body">
                            <p>{{ (k ~ '.detail')|trans }}</p>
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ol>
    </section>

    <section id="skills" class="sectionPath">
        <h2>{{ 'about.skills_title'|trans }}</h2>
        <div class="skillGrid">
            {% for group in skills %}
                <div class="skillCard">
                    <h3>{{ ('about.skills.' ~ group.key ~ '_title')|trans }}</h3>
                    <p>{{ ('about.skills.' ~ group.key)|trans }}</p>
                    <ul class="skillList">
                        {% for item in group.items %}
                            <li>
                                {% if item.icon %}
                                    <img src="{{ asset('assets/img/icon/' ~ item.icon ~ '.webp') }}" alt="" width="20" height="20" loading="lazy" decoding="async">
                                {% endif %}
                                {{ item.name }}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endfor %}
        </div>
    </section>

    <section id="contact" class="sectionContact">
        <h2 class="title middleBaseSize text-center">{{ 'about.contact.title'|trans }}</h2>
        <p class="contactLead">{{ 'about.contact.description'|trans }}</p>
        {% set cv_fr = app.session.get('_locale') == 'fr' %}
        <div class="contactActions">
            <a class="btn btnPrimary" href="{{ asset(cv_fr ? 'assets/files/BASTOS_QUENTIN_CV.pdf' : 'assets/files/BASTOS_QUENTIN_CV_EN.pdf') }}" download="{{ cv_fr ? 'Quentin_Bastos_CV.pdf' : 'Quentin_Bastos_Resume.pdf' }}">{{ 'about.contact.resume'|trans }}</a>
            <a class="btn btnGhost" href="mailto:bastos.quentin.pro@gmail.com">bastos.quentin.pro@gmail.com</a>
        </div>
        <div class="contactLinks">
            <a href="https://www.linkedin.com/in/quentin-bastos-a02838222" target="_blank" rel="noopener" aria-label="{{ 'about.contact.linkedin'|trans }}">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.86-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
                <span>LinkedIn</span>
            </a>
            <a href="https://github.com/QuentinBastos" target="_blank" rel="noopener" aria-label="{{ 'about.contact.github'|trans }}">
                <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                <span>GitHub</span>
            </a>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="https://code.createjs.com/1.0.0/createjs.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.9.1/gsap.min.js" defer></script>
    <script src="/assets/js/background.js" defer></script>
    {{ parent() }}
{% endblock %}
