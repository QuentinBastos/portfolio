{% extends "base.html.twig" %}
{% block title2 %} - {{ "welcome"|trans }}{% endblock %}
{% block body %}
    <canvas id="projector"></canvas>
    {% include "header.html.twig" %}
    <main>
        <div class="wrapper">
            <span class="heroKicker smallBaseSize">{{ 'hero.kicker'|trans }}</span>
            <p class="title titleBaseSize">{{ 'hero.line_1'|trans }}</p>
            <p class="title titleBaseSize">{{ 'hero.line_2'|trans }}</p>
            <p class="heroLead">{{ 'hero.description'|trans }}</p>
        </div>
        <div class="more">
            <a href="#who" class="textBaseSize arrowMore">
                <span class="textBaseSize">{{ 'more'|trans }}</span>
                <img src="{{ asset('assets/svg/arrow.svg') }}" alt="">
            </a>
        </div>
    </main>
    <section id="who" class="sectionWho">
        <div id="particles-js"></div>
        <div class="wrapper">
            <h2 class="titleWho middleBaseSize">{{ 'home.who_title'|trans }}</h2>
            <p class="descriptionWho textBaseSize">{{ 'home.who_description'|trans({'%age%': age()}) }}</p>
            <p class="descriptionWho textBaseSize colorLightGray">{{ 'home.who_details'|trans }}</p>
            <a class="aboutWho smallBaseSize hoverA" href="{{ path('about') }}">{{ 'home.learn_more'|trans }}</a>
            <div class="more">
                <a href="#works" class="textBaseSize arrowMore">
                    <span class="textBaseSize">{{ 'more'|trans }}</span>
                    <img src="{{ asset('assets/svg/arrow.svg') }}" alt="">
                </a>
            </div>
        </div>
    </section>
    <section id="works" class="sectionWorks">
        <div class="titleWho stickyTitle">
            <h2 class="middleBaseSize uppercase">{{ 'home.works_title'|trans }}</h2>
            <p class="textBaseSize">{{ 'home.works_line_1'|trans }}</p>
            <p class="textBaseSize">{{ 'home.works_line_2'|trans }}</p>
            <a href="#{{ (projects|first).slug }}" class="textBaseSize arrowMore mt-7">
                <span class="textBaseSize">{{ 'home.works_cta'|trans }}</span>
                <img src="{{ asset('assets/svg/arrow.svg') }}" alt="">
            </a>
        </div>
        {% for project in projects %}
            {% set title = (project.key ~ '.title')|trans %}
            {% set next = loop.last ? null : projects[loop.index0 + 1] %}
            {% set image = (app.request.locale == 'en' and project.image_en) ? project.image_en : project.image %}
            <div id="{{ project.slug }}" class="projectWrapper">
                <img src="{{ asset(image) }}" alt="" class="centeredImage blurDarker">
                <div class="project">
                    <div class="leftSide">
                        {% if next %}
                            <a href="#{{ next.slug }}" class="smallBaseSize arrowMore projectNext">
                                <span class="smallBaseSize">{{ 'project.next'|trans }}</span>
                                <img src="{{ asset('assets/svg/arrow.svg') }}" alt="">
                            </a>
                        {% else %}
                            <a href="#works" class="smallBaseSize arrowMore projectNext reverseArrow">
                                <img src="{{ asset('assets/svg/arrow.svg') }}" alt="">
                                <span class="smallBaseSize">{{ 'project.back_to_works'|trans }}</span>
                            </a>
                        {% endif %}
                    </div>
                    <div class="middleSide">
                        <a href="{{ path('project_show', {slug: project.slug}) }}" aria-label="{{ title }}">
                            <div class="pre-container css-only">
                                {% for i in 1..9 %}<div></div>{% endfor %}
                                <pre class="language-css">
                                    <img src="{{ asset(project.icon) }}" alt="">
                                    <span class="textOverlay">
                                        <span class="midMiddleBaseSize">{{ title }}</span>
                                    </span>
                                </pre>
                            </div>
                        </a>
                    </div>
                    <div class="rightSide">
                        {% if project.featured %}
                            <span class="featuredBadge">{{ 'project.featured'|trans }}</span>
                        {% endif %}
                        <p class="midMiddleBaseSize title">{{ title }}</p>
                        <ul class="projectMeta">
                            <li>{{ ('project.origin.' ~ project.origin)|trans }}</li>
                            {% if project.year %}<li>{{ project.year|trans }}</li>{% endif %}
                            {% if project.status %}<li>{{ ('project.status.' ~ project.status)|trans }}</li>{% endif %}
                        </ul>
                        <p class="descriptionProject smallBaseSize">{{ (project.key ~ '.tagline')|trans }}</p>
                        <ul class="tagList">
                            {% for tech in project.stack|slice(0, 5) %}
                                <li class="tag">{{ tech }}</li>
                            {% endfor %}
                        </ul>
                        <div class="projectActions">
                            <a href="{{ path('project_show', {slug: project.slug}) }}"
                               class="buttonProject hoverA smallBaseSize">{{ 'project.view'|trans }}</a>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </section>
    <div style="height: 1px; width: 100%; margin: 0; padding: 0; overflow: hidden;"></div>
{% endblock %}

{% block javascripts %}
    <script src="/assets/js/background.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>
    <script src="/assets/js/particles.js"></script>
    <script src="https://code.createjs.com/1.0.0/createjs.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.9.1/gsap.min.js"></script>
    {{ parent() }}
{% endblock %}
