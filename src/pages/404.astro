---
import Base from '../layouts/Base.astro';
import { ui, routes } from '../i18n';
---

<Base lang="fr" title="404 · Quentin Bastos" description={ui.notFoundText.fr} alternates={routes.home}>
  <section class="wrap py-32 text-center">
    <p class="text-7xl font-semibold text-accent">404</p>
    <h1 class="mt-6 text-3xl font-semibold">{ui.notFoundTitle.fr}</h1>
    <p class="mt-3 text-muted">{ui.notFoundText.fr}</p>
    <p class="mt-1 text-muted" lang="en">{ui.notFoundText.en}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn btn-solid">Accueil</a>
      <a href="/en" class="btn" lang="en">Home</a>
    </div>
  </section>
</Base>
