---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import ArchDiagram from './ArchDiagram.astro';
import { ui, routes, type Lang } from '../i18n';
import type { Project } from '../data/projects';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project: p } = Astro.props;
const alternates = routes.project(p.slug);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': p.slug === 'sparklequiz' ? 'SoftwareApplication' : 'CreativeWork',
  name: p.name,
  description: p.summary[lang],
  author: { '@type': 'Person', name: 'Quentin Bastos' },
  ...(p.slug === 'sparklequiz' && {
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web, Android, iOS',
    url: 'https://sparklequiz.com',
  }),
};
---

<Base
  lang={lang}
  title={`${p.name} · Quentin Bastos`}
  description={p.summary[lang]}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article class="wrap pt-28 sm:pt-36">
    <a href={routes.home[lang]} class="link text-sm text-muted">← {ui.back[lang]}</a>
    <p class="eyebrow mt-10">{p.context[lang]} · {p.year}</p>
    <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">{p.name}</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">{p.tagline[lang]}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      {
        p.links.map((l, i) => (
          <a href={l.href} class:list={['btn', i === 0 && 'btn-solid']} rel="noopener">
            {l.label[lang]}
          </a>
        ))
      }
    </div>

    {
      p.cover && (
        <Image
          src={(lang === 'en' && p.cover.en) || p.cover.fr}
          alt={p.cover.alt[lang]}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 64rem, 100vw"
          loading="eager"
          class="mt-12 w-full rounded-2xl border border-line"
        />
      )
    }

    {
      p.stats && (
        <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4">
          {p.stats.map((s) => (
            <div class="flex flex-col-reverse bg-paper p-5">
              <dt class="mt-1 text-sm text-muted">{s.label[lang]}</dt>
              <dd class="text-3xl font-semibold">{s.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="mt-12 grid gap-12 md:grid-cols-[1fr_17rem]">
      <div class="max-w-2xl">
        <p class="text-lg text-pretty">{p.summary[lang]}</p>
        {
          p.role && (
            <p class="mt-6 border-l-2 border-accent pl-4 text-muted">
              <span class="font-semibold text-ink">{lang === 'fr' ? 'Mon rôle. ' : 'My role. '}</span>
              {p.role[lang]}
            </p>
          )
        }
        {
          p.highlights && (
            <section class="mt-12">
              <h2 class="text-2xl font-semibold">{lang === 'fr' ? "Ce que j'ai fait" : 'What I did'}</h2>
              <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-accent">
                {p.highlights.map((h) => <li>{h[lang]}</li>)}
              </ul>
            </section>
          )
        }
        {
          p.sections?.map((s) => (
            <section class="mt-12">
              <h2 class="text-2xl font-semibold">{s.title[lang]}</h2>
              {s.body.map((para) => (
                <p class="mt-4 text-pretty">{para[lang]}</p>
              ))}
              {s.title.en === 'Architecture' && (
                <div class="mt-8">
                  <ArchDiagram lang={lang} />
                </div>
              )}
            </section>
          ))
        }
      </div>
      <aside class="md:sticky md:top-24 md:self-start">
        <h2 class="eyebrow">Stack</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {p.stack.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </aside>
    </div>
    {
      p.screens && (
        <section class="mt-16">
          <h2 class="text-2xl font-semibold">{lang === 'fr' ? "Captures d'écran" : 'Screenshots'}</h2>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            {p.screens.map((sc) => (
              <figure>
                <Image src={sc.src} alt={sc.caption[lang]} widths={[480, 800]} sizes="(min-width: 768px) 21rem, 100vw" class="w-full rounded-xl border border-line" />
                <figcaption class="mt-2 text-sm text-muted">{sc.caption[lang]}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>
