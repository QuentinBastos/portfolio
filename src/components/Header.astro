---
import { ui, routes, langs, langNames, type Lang, type T } from '../i18n';

interface Props {
  lang: Lang;
  alternates: T;
}

const { lang, alternates } = Astro.props;
const home = routes.home[lang];
const nav = [
  { href: '#sparklequiz', label: 'SparkleQuiz' },
  { href: '#parcours', label: ui.navWork[lang] },
  { href: '#projets', label: ui.navProjects[lang] },
  { href: '#stage', label: ui.navInternship[lang] },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-bg/70 backdrop-blur-md transition-colors data-[scrolled]:border-line" data-header>
  <div class="wrap flex h-16 items-center justify-between gap-3 sm:gap-6">
    <a href={home} class="shrink-0 font-mono text-[0.78rem] font-medium tracking-tight">
      quentin<span class="text-accent">/</span>bastos
    </a>
    <nav class="flex items-center gap-0.5 text-[0.8rem] sm:gap-1 sm:text-sm" aria-label="Navigation">
      <ul class="hidden items-center gap-1 lg:flex">
        {nav.map((n) => <li><a href={`${home}${n.href}`} class="rounded-full px-3 py-1.5 text-muted transition-colors hover:text-ink">{n.label}</a></li>)}
      </ul>
      <a href={routes.cv[lang]} class="rounded-full px-1.5 py-1.5 sm:px-3 text-muted transition-colors hover:text-ink">{ui.navCv[lang]}</a>

      <!-- Menu langue : <details> fonctionne sans JS, le script ferme au clic extérieur -->
      <details class="lang-menu relative" data-lang-menu>
        <summary
          class="flex cursor-pointer list-none items-center gap-1 rounded-full px-1.5 py-1.5 sm:px-3 font-mono text-xs uppercase text-muted transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label={ui.langMenu[lang]}
        >
          {lang}
          <svg aria-hidden="true" viewBox="0 0 10 6" class="size-2 transition-transform duration-300"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        </summary>
        <ul class="absolute right-0 mt-2 min-w-36 overflow-hidden rounded-2xl border border-white/90 bg-paper/90 p-1.5 shadow-[0_20px_50px_-20px_rgb(30_30_70/0.35)] backdrop-blur-md">
          {
            langs.map((l) => (
              <li>
                <a
                  href={alternates[l]}
                  hreflang={l}
                  lang={l}
                  aria-current={l === lang ? 'true' : undefined}
                  class:list={[
                    'flex items-center justify-between gap-4 rounded-xl px-3 py-2 text-sm transition-colors hover:bg-bg',
                    l === lang ? 'font-medium text-ink' : 'text-muted',
                  ]}
                >
                  {langNames[l]}
                  <span class="font-mono text-[0.65rem] uppercase">{l}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <a href={`${home}#contact`} class="btn btn-solid ml-1 px-3.5 py-1.5 text-[0.8rem] sm:ml-2 sm:px-4 sm:text-sm">{ui.navContact[lang]}</a>
    </nav>
  </div>
</header>

<style>
  .lang-menu[open] summary svg {
    transform: rotate(180deg);
  }
  .lang-menu[open] ul {
    animation: menu-in 0.35s cubic-bezier(0.2, 0.75, 0.15, 1);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sync = () => header?.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', sync, { passive: true });
  sync();

  const menu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  document.addEventListener('click', (e) => {
    if (menu?.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
