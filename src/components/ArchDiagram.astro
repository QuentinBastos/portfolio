---
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const fr = lang === 'fr';
const clients = ['Web', 'Android', 'iOS'];
const stores = [
  { name: 'MariaDB', note: fr ? 'données' : 'data' },
  { name: 'Redis', note: fr ? 'cache, files' : 'cache, queues' },
  { name: 'Mercure', note: fr ? 'temps réel' : 'real time' },
];
---

<figure class="pop p-5 sm:p-6" aria-label={fr ? "Schéma d'architecture de SparkleQuiz" : 'SparkleQuiz architecture diagram'}>
  <div class="flex flex-col items-stretch gap-3 text-sm">
    <div class="grid grid-cols-3 gap-2">
      {clients.map((c) => <div class="rounded-lg bg-bg px-2 py-2 text-center">{c}</div>)}
    </div>
    <p class="text-center text-xs text-muted">Vue 3 + TypeScript · Capacitor</p>
    <div class="mx-auto h-5 w-px bg-ink" aria-hidden="true"></div>
    <div class="rounded-lg border border-line px-3 py-2 text-center">
      Caddy <span class="text-muted">· blue / green</span>
    </div>
    <div class="mx-auto h-5 w-px bg-ink" aria-hidden="true"></div>
    <div class="rounded-lg bg-ink px-3 py-3 text-center font-semibold text-paper">API Symfony 7 · PHP 8.2</div>
    <div class="mx-auto h-5 w-px bg-ink" aria-hidden="true"></div>
    <div class="grid grid-cols-3 gap-2">
      {
        stores.map((s) => (
          <div class="rounded-lg border border-line px-2 py-2 text-center">
            <div>{s.name}</div>
            <div class="text-xs text-muted">{s.note}</div>
          </div>
        ))
      }
    </div>
  </div>
  <figcaption class="mt-4 border-t border-line pt-3 text-xs text-muted">
    {fr ? 'Déployé par GitHub Actions sur un VPS, publié sur les stores à chaque tag.' : 'Deployed by GitHub Actions to a VPS, published to the stores on every tag.'}
  </figcaption>
</figure>
